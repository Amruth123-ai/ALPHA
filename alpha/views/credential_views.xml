<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Credential List View -->
    <record id="view_alpha_agency_credential_list" model="ir.ui.view">
        <field name="name">alpha.agency.credential.list</field>
        <field name="model">alpha.agency.credential</field>
        <field name="arch" type="xml">
            <list string="Agency Credentials">
                <field name="name"/>
                <field name="agency_id"/>
                <field name="credential_type"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="is_valid" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Credential Form View -->
    <record id="view_alpha_agency_credential_form" model="ir.ui.view">
        <field name="name">alpha.agency.credential.form</field>
        <field name="model">alpha.agency.credential</field>
        <field name="arch" type="xml">
            <form string="Agency Credential">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="credential_code"/>
                            <field name="agency_id"/>
                        </group>
                        <group>
                            <field name="credential_type"/>
                            <field name="issuing_organization"/>
                            <field name="is_valid" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                        </group>
                        <group>
                            <field name="document_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_alpha_agency_credential" model="ir.actions.act_window">
        <field name="name">Agency Credentials</field>
        <field name="res_model">alpha.agency.credential</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>