<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

        <!-- Agency Sequence -->
        <record id="seq_alpha_agency" model="ir.sequence">
            <field name="name">Agency Code</field>
            <field name="code">alpha.agency</field>
            <field name="prefix">AG</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Agency Application Sequence -->
        <record id="seq_alpha_agency_application" model="ir.sequence">
            <field name="name">Agency Application Number</field>
            <field name="code">alpha.agency.application</field>
            <field name="prefix">APP</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Agency Audit Sequence -->
        <record id="seq_alpha_agency_audit" model="ir.sequence">
            <field name="name">Agency Audit Code</field>
            <field name="code">alpha.agency.audit</field>
            <field name="prefix">AUD</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Agency Licence Sequence -->
        <record id="seq_alpha_agency_licence" model="ir.sequence">
            <field name="name">Agency Licence Number</field>
            <field name="code">alpha.agency.licence</field>
            <field name="prefix">LIC</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Agency Workflow Sequence -->
        <record id="seq_alpha_agency_workflow" model="ir.sequence">
            <field name="name">Agency Workflow Code</field>
            <field name="code">alpha.agency.workflow</field>
            <field name="prefix">WF</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>


</odoo>