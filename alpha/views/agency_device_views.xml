<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Device Form View -->
    <record id="view_alpha_agency_device_form" model="ir.ui.view">
        <field name="name">alpha.agency.device.form</field>
        <field name="model">alpha.agency.device</field>
        <field name="arch" type="xml">
            <form string="Agency Device">
                <header>
                    <button name="action_submit" string="Submit for Certification" type="object" class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_test" string="Start Testing" type="object" invisible="state != 'submitted'"/>
                    <button name="action_approve" string="Approve Certification" type="object" class="oe_highlight" invisible="state != 'under_review'" groups="alpha.group_alpha_tc"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'under_review'" groups="alpha.group_alpha_tc"/>
                    <button name="action_expire" string="Expire" type="object" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,submitted,under_review,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="device_code" placeholder="Device Code" required="1"/> - <field name="name" placeholder="Device Name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="agency_id"/>
                            <field name="agency_type" readonly="1"/>
                            <field name="manufacturer"/>
                            <field name="model"/>
                        </group>
                        <group>
                            <field name="serial_number"/>
                            <field name="certification_date" readonly="1"/>
                            <field name="expiry_date"/>
                            <field name="is_expired" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Testing Details">
                            <group>
                                <group>
                                    <field name="testing_result"/>
                                    <field name="test_date"/>
                                    <field name="tested_by"/>
                                </group>
                                <group>
                                    <field name="testing_report_id"/>
                                    <field name="testing_directorate_user_id" readonly="1"/>
                                </group>
                            </group>
                            <field name="testing_comments"/>
                        </page>
                        <page string="Certification Documents">
                            <field name="certification_document_ids"/>
                        </page>
                        <page string="Helpdesk Tickets">
                            <field name="helpdesk_ticket_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Device List View -->
    <record id="view_alpha_agency_device_list" model="ir.ui.view">
        <field name="name">alpha.agency.device.list</field>
        <field name="model">alpha.agency.device</field>
        <field name="arch" type="xml">
            <list string="Agency Devices">
                <field name="device_code"/>
                <field name="name"/>
                <field name="agency_id"/>
                <field name="manufacturer"/>
                <field name="testing_result"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state in ['pending', 'submitted']" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_alpha_agency_device" model="ir.actions.act_window">
        <field name="name">Agency Devices</field>
        <field name="res_model">alpha.agency.device</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>