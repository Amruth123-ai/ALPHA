<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Compliance Requirement List View -->
    <record id="view_alpha_compliance_requirement_list" model="ir.ui.view">
        <field name="name">alpha.compliance.requirement.list</field>
        <field name="model">alpha.compliance.requirement</field>
        <field name="arch" type="xml">
            <list string="Compliance Requirements">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Compliance Requirement Form View -->
    <record id="view_alpha_compliance_requirement_form" model="ir.ui.view">
        <field name="name">alpha.compliance.requirement.form</field>
        <field name="model">alpha.compliance.requirement</field>
        <field name="arch" type="xml">
            <form string="Compliance Requirement">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="agency_type_ids" widget="many2many_tags"/>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Compliance Checklist List View -->
    <record id="view_alpha_compliance_checklist_list" model="ir.ui.view">
        <field name="name">alpha.compliance.checklist.list</field>
        <field name="model">alpha.compliance.checklist</field>
        <field name="arch" type="xml">
            <list string="Compliance Checklists">
                <field name="code"/>
                <field name="name"/>
                <field name="effective_date"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>

    <!-- Compliance Checklist Form View -->
    <record id="view_alpha_compliance_checklist_form" model="ir.ui.view">
        <field name="name">alpha.compliance.checklist.form</field>
        <field name="model">alpha.compliance.checklist</field>
        <field name="arch" type="xml">
            <form string="Compliance Checklist">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="requirement_ids">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                        </list>
                    </field>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_alpha_compliance_requirement" model="ir.actions.act_window">
        <field name="name">Compliance Requirements</field>
        <field name="res_model">alpha.compliance.requirement</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_alpha_compliance_checklist" model="ir.actions.act_window">
        <field name="name">Compliance Checklists</field>
        <field name="res_model">alpha.compliance.checklist</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>